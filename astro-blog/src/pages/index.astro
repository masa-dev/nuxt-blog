---
import ContentList from "../components/content/ContentList.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getAllEntries } from "../lib/content";
import PostLayout from "../layouts/PostLayout.astro";
const [posts, notes] = await Promise.all([
  getAllEntries("post"),
  getAllEntries("note"),
]);
const latestPosts = posts.slice(0, 4);
const latestNotes = notes.slice(0, 4);
---

<PostLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="n-container-xl mx-auto mb-5" data-pagefind-ignore>
    <h2 class="mb-5 mt-4 font-weight-bold">投稿一覧</h2>
    <ContentList entries={latestPosts} />
    <div class="text-end">
      <a href="/post/" class="btn mb-4">投稿一覧を見る</a>
    </div>
    <h2 class="mb-5 mt-4 font-weight-bold">ノート一覧</h2>
    <ContentList entries={latestNotes} />
    <div class="text-end">
      <a href="/note/" class="btn">ノート一覧を見る</a>
    </div>
  </div>
</PostLayout>

<style>
  a.btn {
    color: #5851ec;
    background-color: #ecf2fc;
    transition: 0.3s;
  }

  a.btn:hover {
    background-color: #dbe6f8;
  }
</style>
