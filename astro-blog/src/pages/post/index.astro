---
import Pagination from "../../components/Pagination.astro";
import ContentList from "../../components/content/ContentList.astro";
import { POST_LIMIT } from "../../consts";
import { getAllEntries } from "../../lib/content";
import PostLayout from "../../layouts/PostLayout.astro";
const posts = await getAllEntries("post");
const pageMeta = {
  rows: Math.ceil(posts.length / POST_LIMIT),
  currentPage: 1,
};
const linkGen = (pageNum: number) => `/post/page/${pageNum}/`;
---

<PostLayout title="Post一覧 | MasaDev Blog" description="技術記事の一覧">
  <div class="n-container-xl mx-auto mb-5" data-pagefind-ignore>
    <h2 class="mb-5 mt-4 font-weight-bold">Post一覧</h2>
    <ContentList entries={posts.slice(0, POST_LIMIT)} />
    <Pagination
      page={pageMeta.currentPage}
      linkGen={linkGen}
      numberOfPages={pageMeta.rows}
    />
  </div>
</PostLayout>
