---
import Pagination from "../../../components/Pagination.astro";
import ContentList from "../../../components/content/ContentList.astro";
import { POST_LIMIT, SITE_DESCRIPTION, SITE_TITLE } from "../../../consts";
import { getAllEntries } from "../../../lib/content";
import PostLayout from "../../../layouts/PostLayout.astro";

export async function getStaticPaths() {
  const posts = await getAllEntries("post");
  const pageCount = Math.ceil(posts.length / POST_LIMIT);
  return [...Array(pageCount)].map((_, i) => ({
    params: { page: String(i + 1) },
  }));
}

const { page } = Astro.params;
const currentPage = Number(page ?? "1");
const posts = await getAllEntries("post");
const pageMeta = {
  rows: Math.ceil(posts.length / POST_LIMIT),
  currentPage,
};
const pagePosts = posts.slice(
  (currentPage - 1) * POST_LIMIT,
  currentPage * POST_LIMIT,
);
const linkGen = (pageNum: number) => `/post/page/${pageNum}/`;
---

<PostLayout title={`Post一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <div class="n-container-xl mx-auto mb-5" data-pagefind-ignore>
    <h2 class="mb-5 mt-4 font-weight-bold">Post一覧</h2>
    <ContentList entries={pagePosts} />
    <Pagination
      page={pageMeta.currentPage}
      linkGen={linkGen}
      numberOfPages={pageMeta.rows}
    />
  </div>
</PostLayout>
