---
import { render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { getAllEntries, getEntryBySlug } from "../../lib/content";

export async function getStaticPaths() {
  const notes = await getAllEntries("note");
  return notes.map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;
const entry = slug ? await getEntryBySlug("note", slug) : undefined;

if (!entry) {
  return Astro.redirect("/404");
}

const rendered = await render(entry.entry);
const { Content } = rendered;
---

<ContentLayout entry={entry}>
  <Content />
</ContentLayout>
