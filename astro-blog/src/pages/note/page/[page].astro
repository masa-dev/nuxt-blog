---
import Pagination from "../../../components/Pagination.astro";
import ContentList from "../../../components/content/ContentList.astro";
import { NOTE_LIMIT, SITE_DESCRIPTION, SITE_TITLE } from "../../../consts";
import { getAllEntries } from "../../../lib/content";
import PostLayout from "../../../layouts/PostLayout.astro";

export async function getStaticPaths() {
  const notes = await getAllEntries("note");
  const pageCount = Math.ceil(notes.length / NOTE_LIMIT);
  return [...Array(pageCount)].map((_, i) => ({
    params: { page: String(i + 1) },
  }));
}

const { page } = Astro.params;
const currentPage = Number(page ?? "1");
const notes = await getAllEntries("note");
const pageMeta = {
  rows: Math.ceil(notes.length / NOTE_LIMIT),
  currentPage,
};
const pageNotes = notes.slice(
  (currentPage - 1) * NOTE_LIMIT,
  currentPage * NOTE_LIMIT,
);
const linkGen = (pageNum: number) => `/note/page/${pageNum}/`;
---

<PostLayout title={`Note一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <div class="n-container-xl mx-auto mb-5" data-pagefind-ignore>
    <h2 class="mb-5 mt-4 font-weight-bold">Note一覧</h2>
    <ContentList entries={pageNotes} />
    <Pagination
      page={pageMeta.currentPage}
      linkGen={linkGen}
      numberOfPages={pageMeta.rows}
    />
  </div>
</PostLayout>
