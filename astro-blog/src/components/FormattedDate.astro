---
interface Props {
  date: Date;
  withTime?: boolean;
}

const { date, withTime = false } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    withTime
      ? date
          .toLocaleString("ja-JP", {
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
            hour: "2-digit",
            minute: "2-digit",
          })
          .replace(/^(\d+)\/(\d+)\/(\d+)\s/, "$1年$2月$3日 ")
      : date.toLocaleDateString("en-us", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })
  }
</time>
