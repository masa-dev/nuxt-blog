---
import { format } from "date-fns";

type Props = {
  createdAt: Date;
  updatedAt?: Date;
};

const { createdAt, updatedAt } = Astro.props;

const formatDate = (date: Date) => format(date, "yyyy年M月d日");

const toISODate = (date: Date) => format(date, "yyyy-MM-dd");
---

<div class="post-date mb-3 text-end">
  {
    createdAt && (
      <div class="post-date-time time-create mb-1">
        <time class="d-none" data-pagefind-meta="date">
          {formatDate(createdAt)}
        </time>
        <time datetime={toISODate(createdAt)}>{formatDate(createdAt)}</time>
      </div>
    )
  }

  {
    updatedAt && (
      <div class="post-date-time time-update">
        <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
      </div>
    )
  }
</div>

<style lang="scss" scoped>
  @use "../styles/variables" as *;

  .post-date {
    line-height: 1.5;
    .post-date-time {
      font-size: 0.9rem;
      white-space: nowrap;

      &::before {
        display: inline-block;
        height: 0.8rem;
        width: 0.8rem;
        margin-right: 0.5rem;
      }
    }

    .time-create {
      &::before {
        content: url(/img/pen-solid.svg);
      }
    }

    .time-update {
      &::before {
        content: url(/img/rotate-right-solid.svg);
      }
    }
  }

  @media only screen and (min-width: $hide-sidebar) {
    .post-date {
      display: none;
    }
  }
</style>
