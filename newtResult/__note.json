            "_sys": {
                "raw": {
                    "createdAt": "2023-04-08T18:39:42.999Z",
                    "updatedAt": "2023-04-09T05:59:51.636Z",
                    "firstPublishedAt": "2023-04-08T18:39:42.999Z",
                    "publishedAt": "2023-04-09T05:59:51.636Z"
                },
                "customOrder": 6,
                "createdAt": "2023-04-08T18:39:42.999Z",
